erDiagram
    direction TB
    %% Baseline workbook version 3 plus FR88 favourite_properties,20October2026.
    %% All application primary and foreign keys use UUID.
    %% auth_users is only a managed Supabase auth.users reference.
    %% property_reviews is P2 deferred; notifications are inserted synchronously by each action.
    %% Contract terms/documents are immutable; embedded confirmation fields are write-once.
    %% GiST exclusion, composite FKs and transition triggers are migration rules, not Mermaid syntax.

    auth_users {
        uuid id PK "Provider managed identity UUID"
        text email "Optional. Provider managed email; password/session internals intentionally omitted"
    }

    user_profiles {
        uuid id PK "Profile row id. Other tables reference this id."
        uuid user_id FK,UK "References auth.users.id. JWT sub matches this column. One profile per identity."
        text email "Address copied from Auth at signup"
        text full_name "Validated display/contact name"
        text phone "Optional. Optional contact number; not OTP ownership verification"
        boolean is_admin "Trusted server-managed moderation privilege"
        text account_status "ACTIVE or SUSPENDED"
        timestamptz created_at "Record creation time in UTC"
        timestamptz updated_at "Last record update time in UTC"
    }

    properties {
        uuid id PK "Application UUID"
        uuid owner_id FK "Authorized manager profile; MVP one owner"
        text name "Property name"
        text property_type "HOUSE APARTMENT APARTMENT_BUILDING"
        text rental_arrangement "WHOLE_SPACE or SEPARATE_UNITS"
        text address_line "Optional. Street and building address; may be null in incomplete draft, required at listing submission/publication"
        text ward "Optional. Current ward/commune selected from the administrative division list"
        text city "Optional. Current province/city selected from the administrative division list"
        text description "Optional. Shared property description; may be null in incomplete draft, required at listing submission/publication"
        jsonb shared_amenities "Shared property facilities; schema_version, standard catalog keys with enabled/details, custom text array"
        jsonb policies "schema_version defaults pets/smoking and shared_rules"
        integer content_revision "Increment on property/unit/media/policy content writes; initial listing stale-review guard"
        numeric latitude "Optional. Optional geocoding latitude -90 to90"
        numeric longitude "Optional. Optional longitude -180 to180"
        timestamptz archived_at "Optional. Archive instead of destructive delete"
        timestamptz created_at "Record creation time in UTC"
        timestamptz updated_at "Last record update time in UTC"
    }

    units {
        uuid id PK "Stable unit UUID"
        uuid property_id FK "Parent property"
        text label "Room S201 or Entire property; normalized label unique per property"
        text normalized_label "NFC-normalized, trimmed, whitespace-collapsed lowercase label; unique with property_id"
        text unit_kind "ROOM STUDIO APARTMENT HOUSE"
        text description "Optional. Unit specific description; may be null in incomplete draft, required at listing submission/publication"
        text floor "Optional. Flexible floor label"
        numeric area_m2 "Optional. Positive floor area; may be null in incomplete draft, required at listing submission/publication"
        integer bedrooms "Nonnegative; room/studio may use0"
        numeric bathrooms "Nonnegative count"
        text bathroom_arrangement "PRIVATE or SHARED"
        jsonb amenities "Features inside unit; schema_version, standard catalog keys with enabled/details, custom text array"
        numeric advertised_monthly_rent "Optional. Positive NUMERIC(14,0) VND; not agreed contract rent; may be null in incomplete draft, required at listing submission/publication"
        numeric deposit "Optional. Nonnegative NUMERIC(14,0) VND; may be null in incomplete draft, required at listing submission/publication"
        integer minimum_rental_months "At least3"
        integer max_occupants "Optional. Positive occupancy limit; may be null in incomplete draft, required at listing submission/publication"
        text operational_status "READY MAINTENANCE RETIRED"
        boolean is_marketed "Explicit owner advertising choice; enable only with complete required unit data"
        jsonb policy_overrides "Allowed enum overrides and additional_rules"
        timestamptz archived_at "Optional. Preserve historical references"
        timestamptz created_at "Record creation time in UTC"
        timestamptz updated_at "Last record update time in UTC"
    }

    property_media {
        uuid id PK "Photo UUID; no review or replacement-chain state"
        uuid property_id FK "Parent property"
        uuid unit_id FK "Optional. Optional unit in same property"
        uuid uploaded_by FK "Authorized uploader"
        text storage_path UK "Unique object path; no overwriting referenced bytes"
        text caption "Optional. Owner caption; plain text"
        integer sort_order "Gallery order"
        boolean is_selected_for_listing "Owner gallery selection; no photo moderation"
        timestamptz purged_at "Optional. Storage file deletion confirmed"
        timestamptz created_at "Record creation time in UTC"
        timestamptz updated_at "Last record update time in UTC"
        timestamptz deleted_at "Optional. Soft removal; hidden from gallery; retention starts"
        text sha256 "Hash of completed image bytes"
        text mime_type "Validated decoded image media type"
        bigint size_bytes "Positive completed file byte count"
    }

    listings {
        uuid id PK "Listing UUID"
        uuid property_id FK "One nonarchived listing per property"
        text title "Public title"
        text description "Advertisement copy"
        uuid cover_media_id FK "Optional. Selected nondeleted same-property shared media; required to publish"
        text moderation_status "DRAFT PENDING APPROVED REJECTED"
        text publication_status "DRAFT PUBLISHED HIDDEN"
        timestamptz submitted_at "Optional. Review request time"
        uuid reviewed_by FK "Optional. Admin reviewer"
        timestamptz reviewed_at "Optional. Decision time"
        text review_reason "Optional. Required rejection or suspension reason"
        timestamptz archived_at "Optional. Historical listing"
        timestamptz created_at "Record creation time in UTC"
        timestamptz updated_at "Last record update time in UTC"
        integer submitted_content_revision "Optional. Property content_revision captured at initial submission"
        integer approved_content_revision "Optional. Historical revision initially approved; later edits need not equal it"
        timestamptz admin_suspended_at "Optional. Admin restriction independent of initial approval and owner publication"
        uuid admin_suspended_by FK "Optional. Suspending admin profile"
        text suspension_reason "Optional. Required while admin-suspended"
    }

    rental_requests {
        uuid id PK "Enquiry UUID"
        uuid listing_id FK "Source listing"
        uuid tenant_id FK "Authenticated prospect"
        uuid preferred_unit_id FK "Optional. Optional preference in listing property"
        date desired_move_in_date "Preference not contractual start"
        text message "Enquiry text"
        text status "PENDING ACCEPTED REJECTED WITHDRAWN; ACCEPTED means tenancy proposal committed"
        text outcome_reason "Optional. Required rejection/automatic closure explanation"
        timestamptz created_at "Record creation time in UTC"
        timestamptz updated_at "Last record update time in UTC"
        text contact_name "Private submitted contact snapshot"
        text contact_phone "Private normalized phone snapshot; no OTP verification"
        date desired_end_date "Inclusive end of requested period; required to assess actual availability"
        timestamptz availability_checked_at "Optional. Last due15-day evaluation timestamp"
        timestamptz closed_at "Optional. Terminal request transition time"
    }

    tenancies {
        uuid id PK "Tenancy UUID"
        uuid unit_id FK "Exact allocated unit"
        uuid tenant_id FK "Primary tenant matches original enquiry"
        uuid rental_request_id FK,UK "One result per accepted enquiry"
        text status "PENDING_CONFIRMATION AWAITING_REVISION CONFIRMED ACTIVE EXPIRED CANCELLED ENDED"
        timestamptz actual_ended_at "Optional. Actual move-out/end or cancellation action"
        text end_reason "Optional. Required when ending/cancelling"
        timestamptz created_at "Record creation time in UTC"
        timestamptz updated_at "Last record update time in UTC"
        uuid owner_id FK "Manager party snapshot for contract confirmation"
        date confirmed_start_date "Optional. Projection: first mutually confirmed segment start"
        date confirmed_end_date "Optional. Projection: last mutually confirmed consecutive segment end"
        date blocked_start_date "Optional. Blocking envelope start, includes proposed original/confirmed span"
        date blocked_end_date "Optional. Blocking envelope end, includes pending renewal extension"
        uuid pending_contract_id FK "Optional. Current unconfirmed version in same tenancy; composite FK"
        uuid latest_confirmed_contract_id FK "Optional. Latest mutually confirmed segment version in same tenancy"
        timestamptz confirmation_expires_at "Optional. Server deadline for current pending version only"
        timestamptz moved_in_at "Optional. Owner-reported actual move-in event time"
    }

    tenancy_renewal_requests {
        uuid id PK "Renewal request UUID"
        uuid tenancy_id FK "Existing CONFIRMED or ACTIVE continuing tenancy"
        date requested_end_date "Proposed later end date"
        numeric proposed_monthly_rent "Positive NUMERIC(14,0) VND"
        text message "Optional. Tenant explanation"
        text status "PENDING ACCEPTED REJECTED CANCELLED"
        uuid reviewed_by FK "Optional. Owner for rejection; acceptance derives from final mutual confirmation"
        timestamptz reviewed_at "Optional. Outcome time"
        text review_reason "Optional. Required for rejection"
        timestamptz created_at "Record creation time in UTC"
        timestamptz updated_at "Last record update time in UTC"
    }

    tenancy_contracts {
        uuid id PK "Immutable version UUID"
        uuid tenancy_id FK "Parent continuous tenancy"
        integer version_number "Monotonic per tenancy; unique with tenancy_id"
        text type "ORIGINAL or RENEWAL; corrections preserve type"
        uuid renewal_request_id FK "Optional. For RENEWAL segment and corrections; many versions may share request"
        uuid supersedes_contract_id FK "Optional. Previous unconfirmed version in same tenancy/segment; no confirmed amendment MVP"
        uuid basis_contract_id FK "Optional. Confirmed preceding segment for renewal; null for original"
        date start_date "Inclusive segment start; renewal starts prior confirmed end+1"
        date end_date "Inclusive segment end"
        numeric monthly_rent "NUMERIC(14,0) positive VND applicable to this segment"
        numeric deposit_amount "NUMERIC(14,0) nonnegative agreed deposit; do not double-charge on renewal"
        jsonb policies_snapshot "Required actually negotiated resolved policies snapshot"
        text document_path UK "Private unique immutable object path; protect bytes from overwrite/delete"
        text document_sha256 "SHA256 of exact stored document bytes"
        date signed_on "Optional. Optional owner-reported offline signing date, not platform verified"
        uuid created_by FK "Owner creating and explicitly acknowledging proposal"
        timestamptz created_at "Version inserted time in UTC"
        timestamptz owner_confirmed_at "Explicit owner acknowledgement of this exact contract UUID and document hash; set at proposal submission; never rewritten"
        timestamptz tenant_confirmed_at "Optional. Tenant acknowledgement of this exact contract UUID/hash; write once from null; excludes rejection"
        timestamptz tenant_rejected_at "Optional. Tenant decline of this exact contract; write once from null; excludes confirmation"
        text tenant_rejection_reason "Optional. Required when tenant declines; written with tenant_rejected_at and never rewritten"
    }

    listing_reports {
        uuid id PK "Report UUID"
        uuid listing_id FK "Reported advertisement"
        uuid reporter_id FK "Authenticated reporter"
        text reason_code "FRAUD MISLEADING HARMFUL OTHER"
        text description "Reporter explanation"
        text status "OPEN REVIEWING RESOLVED DISMISSED"
        text resolution_summary "Optional. Sanitized reporter-visible outcome"
        text internal_notes "Optional. Admin only investigation details"
        uuid reviewed_by FK "Optional. Admin deciding"
        timestamptz reviewed_at "Optional. Decision time"
        timestamptz created_at "Record creation time in UTC"
        timestamptz updated_at "Last record update time in UTC"
    }



    notifications {
        uuid id PK "Inbox UUID"
        uuid recipient_id FK "Only this user can read/mark read"
        text event_key "Unique with recipient_id"
        text title "Safe summary"
        text body "Safe message"
        text resource_type "Authorized application link kind"
        uuid resource_id "Target resource UUID; backend checks access"
        timestamptz read_at "Optional. First read time"
        timestamptz created_at "Inbox creation time"
    }

    property_reviews {
        uuid id PK "Review UUID"
        uuid tenancy_id FK,UK "One review per tenancy; property/tenant derived"
        integer rating "1 to5"
        text comment "Escaped plain text"
        text review_status "PENDING APPROVED REJECTED"
        uuid reviewed_by FK "Optional. Admin reviewer"
        timestamptz reviewed_at "Optional. Decision time"
        text review_reason "Optional. Required on rejection/removal"
        timestamptz created_at "Record creation time in UTC"
        timestamptz updated_at "Last record update time in UTC"
    }


    auth_users ||--o| user_profiles : "id"
    user_profiles ||--o{ properties : "owner_id"
    properties ||--o{ units : "property_id"
    properties ||--o{ property_media : "property_id"
    units o|--o{ property_media : "unit_id"
    user_profiles ||--o{ property_media : "uploaded_by"
    properties ||--o{ listings : "property_id"
    property_media o|--o{ listings : "cover_media_id"
    user_profiles o|--o{ listings : "reviewed_by"
    user_profiles o|--o{ listings : "admin_suspended_by"
    listings ||--o{ rental_requests : "listing_id"
    user_profiles ||--o{ rental_requests : "tenant_id"
    units o|--o{ rental_requests : "preferred_unit_id"
    units ||--o{ tenancies : "unit_id"
    user_profiles ||--o{ tenancies : "tenant_id"
    rental_requests ||--o| tenancies : "rental_request_id"
    user_profiles ||--o{ tenancies : "owner_id"
    tenancy_contracts o|--o| tenancies : "pending_contract_id"
    tenancy_contracts o|--o| tenancies : "latest_confirmed_contract_id"
    tenancies ||--o{ tenancy_renewal_requests : "tenancy_id"
    user_profiles o|--o{ tenancy_renewal_requests : "reviewed_by"
    tenancies ||--o{ tenancy_contracts : "tenancy_id"
    tenancy_renewal_requests o|--o{ tenancy_contracts : "renewal_request_id"
    tenancy_contracts o|--o{ tenancy_contracts : "supersedes_contract_id"
    tenancy_contracts o|--o{ tenancy_contracts : "basis_contract_id"
    user_profiles ||--o{ tenancy_contracts : "created_by"
    listings ||--o{ listing_reports : "listing_id"
    user_profiles ||--o{ listing_reports : "reporter_id"
    user_profiles o|--o{ listing_reports : "reviewed_by"
    user_profiles ||--o{ notifications : "recipient_id"
    tenancies ||--o| property_reviews : "tenancy_id"
    user_profiles o|--o{ property_reviews : "reviewed_by"

    favourite_properties {
        uuid id PK "Favourite identity"
        uuid user_id FK "Verified profile; unique together with property_id"
        uuid property_id FK "Stable saved property, not listing or unit"
        timestamptz created_at "Server save timestamp"
    }
    user_profiles ||--o{ favourite_properties : "user_id"
    properties ||--o{ favourite_properties : "property_id"
