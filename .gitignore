# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/generated/prisma


# Keep the shared auth redirect configuration; ignore local Supabase state.
/supabase/*
!/supabase/config.toml


# ignore local plan
.local_plans/

# Keep the shared Figma rule; ignore other local Cursor configuration.
/.cursor/*
!/.cursor/rules/
/.cursor/rules/*
!/.cursor/rules/figma-design.mdc

# Local implementation and review notes
/.superpowers/
