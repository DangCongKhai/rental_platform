# Copy to .env. Local Supabase values come from `supabase status`.
# Hosted values come from the project Connect dialog. Do not commit .env.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable key from supabase status>
SUPABASE_SECRET_KEY=<secret key from supabase status>

# App queries. Local Supabase uses the direct database URL.
# A hosted project uses the transaction pooler, port 6543, with ?pgbouncer=true.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Prisma Migrate. Local Supabase uses the same direct URL.
# A hosted project uses the session or direct connection, port 5432.
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
